*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories. Anchored with a leading slash so they match only the one
# at the repository root: without it, `build/` also swallows the source
# directories `include/fastatoms/build/` and `src/build/`, and new files there
# are silently never committed.
/build/
/Build/
/build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
wheelhouse/

# FastAtoms
_deps/

# Output the shipped examples write when run from the repository root. They
# use relative paths on purpose, so a copied input file writes next to itself;
# running them in place should still leave the tree clean. (*.log is already
# covered above; these are the trajectories, two of which are YAML and would
# otherwise look like real input files.)
argon-md.xyz
si_md.yaml
water_opt.yaml
water-spce.xyz
neb_argon_band.extxyz
band.extxyz
*.traj

# Agent working notes (local only)
CLAUDE.md
