@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The static core does not absorb its dependencies, so a consumer needs them
# too. Both are recorded here as they were resolved at build time.
find_dependency(yaml-cpp)

if(@FASTATOMS_OPENMP_FOUND@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FastAtomsTargets.cmake")

check_required_components(FastAtoms)
